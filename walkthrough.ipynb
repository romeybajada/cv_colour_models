    "    if n == 1:\n",
    "        axes = [axes]\n",
    "    for i, (img, title) in enumerate(zip(images, titles)):\n",
    "        cmap = cmap_list[i] if cmap_list else None\n",
    "        axes[i].imshow(img, cmap=cmap)\n",
    "        axes[i].set_title(title)\n",
    "        axes[i].axis('off')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "show_images([img_rgb], ['Original RGB Image'])"
   ]
